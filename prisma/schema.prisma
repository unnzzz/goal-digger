datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String?
  coins        Int               @default(0)
  createdAt    DateTime          @default(now())
  goals        Goal[]
  diary        DiaryEntry[]
  completions  QuestCompletion[]
}

model Goal {
  id           String            @id @default(cuid())
  userId       String
  title        String
  dailyMinutes Int
  totalDays    Int
  roadmapJson  Json
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id])
  diary        DiaryEntry[]
  completions  QuestCompletion[]
}

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  goalId    String?
  date      DateTime
  type      String // "practice" | "reflect"
  content   String
  dayNumber Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  goal      Goal?    @relation(fields: [goalId], references: [id])
}

model QuestCompletion {
  id           String   @id @default(cuid())
  userId       String
  goalId       String
  dayNumber    Int
  section      String // "learn" | "practice" | "reflect"
  index        Int
  coinsAwarded Int
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  goal         Goal     @relation(fields: [goalId], references: [id])
}
