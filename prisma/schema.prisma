datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  coins        Int      @default(0)
  createdAt    DateTime @default(now())

  tz           String?        // <-- user's IANA time zone for reminders

  goals        Goal[]
  diary        DiaryEntry[]
  completions  QuestCompletion[]
  reminders    ReminderState[] // <-- relation
}

model ReminderState {
  id         String   @id @default(cuid())
  userId     String
  dateLabel  String         // YYYY-MM-DD in user's TZ
  lastSentAt DateTime?      // UTC timestamp of last reminder
  completed  Boolean  @default(false) // true when all daily quests completed

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, dateLabel])
}


model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  dailyMinutes Int
  totalDays    Int
  roadmapJson  Json
  startDate    DateTime?
  contentHash  String?            // ← NEW: idempotency key per user+roadmap
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])
  diary        DiaryEntry[]
  completions  QuestCompletion[]

  @@unique([userId, contentHash]) // ← NEW (allows multiple NULL; unique when hash exists)
}

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  goalId    String
  type      String   // "practice" | "reflect"
  content   String
  date      DateTime @default(now()) // legacy timestamp
  dateLabel String?                  // <- STEP 1: nullable for backfill
  dayNumber Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  goal Goal @relation(fields: [goalId], references: [id])

  @@index([userId, dateLabel])
  @@index([goalId, dateLabel])
}


model QuestCompletion {
  id           String   @id @default(cuid())
  userId       String
  goalId       String
  dayNumber    Int
  section      String // "learn" | "practice" | "reflect"
  index        Int
  coinsAwarded Int
  completedAt  DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  goal         Goal     @relation(fields: [goalId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@index([identifier])
}
