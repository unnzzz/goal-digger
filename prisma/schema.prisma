generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  name          String?
  coins         Int               @default(0)
  createdAt     DateTime          @default(now())
  tz            String?
  avatarKey     String?
  statINT       Int               @default(0)
  statSTR       Int               @default(0)
  statVIT       Int               @default(0)
  statAES       Int               @default(0)
  statWLH       Int               @default(0)
  emailVerified DateTime?
  diary         DiaryEntry[]
  goals         Goal[]
  completions   QuestCompletion[]
  reminders     ReminderState[]
  items         UserItem[]
}

model ReminderState {
  id         String    @id @default(cuid())
  userId     String
  dateLabel  String
  lastSentAt DateTime?
  completed  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id])

  @@unique([userId, dateLabel])
}

model Goal {
  id           String            @id @default(cuid())
  userId       String
  title        String
  dailyMinutes Int
  totalDays    Int
  roadmapJson  Json
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  startDate    DateTime?
  contentHash  String?
  diary        DiaryEntry[]
  user         User              @relation(fields: [userId], references: [id])
  completions  QuestCompletion[]

  @@unique([userId, contentHash])
}

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  goalId    String
  type      String
  content   String
  date      DateTime @default(now())
  dateLabel String?
  dayNumber Int?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, dateLabel])
  @@index([goalId, dateLabel])
}

model QuestCompletion {
  id           String   @id @default(cuid())
  userId       String
  goalId       String
  dayNumber    Int
  section      String
  index        Int
  coinsAwarded Int
  completedAt  DateTime @default(now())
  goal         Goal     @relation(fields: [goalId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@index([identifier])
}

model ShopItem {
  id        String       @id @default(cuid())
  name      String       @unique
  category  ItemCategory
  cost      Int
  intBoost  Int          @default(0)
  strBoost  Int          @default(0)
  vitBoost  Int          @default(0)
  aesBoost  Int          @default(0)
  wlhBoost  Int          @default(0)
  reqINT    Int          @default(0)
  reqSTR    Int          @default(0)
  reqVIT    Int          @default(0)
  reqAES    Int          @default(0)
  reqWLH    Int          @default(0)
  reqStatus String?
  imageKey  String?
  createdAt DateTime     @default(now())
  userItems UserItem[]   @relation("UserItemsOnShopItem")
}

model UserItem {
  id       String   @id @default(cuid())
  userId   String
  itemId   String
  placed   Boolean  @default(false)
  posX     Int?
  posY     Int?
  rotation Float    @default(0)
  scale    Float    @default(1)
  item     ShopItem @relation("UserItemsOnShopItem", fields: [itemId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
}

enum ItemCategory {
  NERDY
  FITNESS
  GREENTHUMB
  CREATIVE
  COZY
  LUXURY
  MINIMALIST
  VINTAGE
}
